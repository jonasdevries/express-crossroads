{
  "name": "express-crossroads",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx --watch --env-file .env src/index.ts",
    "dev:dev": "tsx --watch --env-file .env.dev src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --max-warnings=0"
    ],
    "src/**/*.{js,jsx}": [
      "eslint --max-warnings=0"
    ],
    "tests/**/*.{ts,tsx,js,jsx}": [
      "eslint --max-warnings=0"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --check"
    ]
  },
  "imports": {
    "#*": "./src/*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonasdevries/express-crossroads.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/jonasdevries/express-crossroads/issues"
  },
  "homepage": "https://github.com/jonasdevries/express-crossroads#readme",
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@supabase/supabase-js": "^2.76.1",
    "@tsconfig/node22": "^22.0.2",
    "@types/express": "^5.0.5",
    "@types/node": "^24.9.1",
    "@types/pg": "^8.15.6",
    "@vitest/coverage-v8": "^4.0.4",
    "@vitest/eslint-plugin": "^1.3.26",
    "eslint": "^9.38.0",
    "eslint-plugin-perfectionist": "^4.15.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "pg": "^8.16.3",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^4.0.4"
  }
}
